# Third-party evidence is not redistributed: only its provenance is tracked.
# Rebuild it locally with `python3 review_sources/fetch_sources.py --fetch`.
review_sources/**
!review_sources/**/
!review_sources/README.md
!review_sources/SOURCES.json
!review_sources/fetch_sources.py
!review_sources/algorithms/manifest.json
!review_sources/algorithms/manifest_supplemental.json
!review_sources/formalisation/PROVENANCE.md
!review_sources/formalisation/downloads/isocert-head.json
!review_sources/formalisation/downloads/mathlib-head.json
!review_sources/formalisation/mathlib/archive-paths.txt
!review_sources/hardware/README.md
!review_sources/hardware/manifest.json

# Local agent tooling.
.claude/

# Local interpreter/build scratch.
__pycache__/
*.py[cod]
.lake/

# Build outputs and Lean build state.
build/
*.o
*.a
lean/.lake/

# M0 generated corpus: regenerated from the seeds in refs/vectors/generated/MANIFEST.json
# (`make corpus`); the files are not committed (12 MB for T1).
refs/vectors/generated/*.json
!refs/vectors/generated/MANIFEST.json
